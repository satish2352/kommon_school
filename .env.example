# ============================================================
# Kommon School — Frontend (Vite + React 19)
# Copy this file to .env and fill in real values.
# All VITE_ prefixed variables are inlined at build time.
# ============================================================

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public site host (no trailing slash) used to build shareable links such as
# the student upgrade link: <VITE_PUBLIC_SITE_URL>/upgrade/<email>
VITE_PUBLIC_SITE_URL=http://localhost:5173


# VITE_API_BASE_URL=https://scopify.api.sumagodemo.com/api/v1